{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(mvn -q test *)",
      "Bash(mvn test *)",
      "Bash(mvn -q compile *)",
      "Bash(mvn -q verify *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Edit(./src/test/**)",
      "Edit(./pom.xml)",
      "Edit(./CLAUDE.md)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(rm -rf *)"
    ]
  }
}
